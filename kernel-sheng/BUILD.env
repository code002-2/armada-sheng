# --- Xiaomi Pad 6S Pro (sheng) kernel source ---------------------------------
# Armada's sheng variant does NOT use armada-packages' kernel.org build.
# Instead it points straight at ianchb/sm8550-mainline, the community
# (map220v lineage) mainline tree that carries the sm8550-xiaomi-sheng board
# support: DTS, touchscreen (Goodix Berlin), UFS/battery/audio quirks, etc.
KERNEL_REPO=https://github.com/ianchb/sm8550-mainline
KERNEL_BRANCH=sheng-7.2.2
KERNEL_CONFIG=sm8550.config

# Armada runtime features merged on top of the sheng base config (beyond what
# the sheng config already enables). See sheng-armada.config.overrides.
KERNEL_OVERRIDES=sheng-armada.config.overrides
