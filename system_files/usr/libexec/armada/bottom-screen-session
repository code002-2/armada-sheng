#!/bin/bash
set -euo pipefail

if [[ -z "${DISPLAY:-}" ]]; then
    echo "bottom-screen-session: nested Gamescope did not provide an X11 display" >&2
    exit 1
fi

dbus_run_session=${ARMADA_DBUS_RUN_SESSION:-/usr/bin/dbus-run-session}
kwin_wayland=${ARMADA_KWIN_WAYLAND:-/usr/bin/kwin_wayland}

export XDG_CURRENT_DESKTOP=KDE
export XDG_CONFIG_DIRS="$HOME/.config/plasma-mobile:/etc/xdg${XDG_CONFIG_DIRS:+:$XDG_CONFIG_DIRS}"
export DISABLE_GAMESCOPE_WSI=1
unset GAMESCOPE_WAYLAND_DISPLAY GAMESCOPE_LIMITER_FILE

exec "$dbus_run_session" \
    "$kwin_wayland" \
    --x11-display "$DISPLAY" \
    --fullscreen \
    --no-lockscreen \
    --exit-with-session '/usr/bin/plasmashell -p org.kde.plasma.mobileshell'
